// Keep the best model checkpoint under integer loss minimization and restore it on a stop request.
use std::cli;

pub fn checkpoint_elect_start() -> vector { [0, 0, 0] }

pub fn checkpoint_elect_step(snapshot: vector, event: str, value: f64) -> vector {
    if len(snapshot) != 3 { return []; }
    let phase = at(snapshot, 0);
    let saved = at(snapshot, 1);
    let previous = at(snapshot, 2);
    if !(phase >= 0.0 && phase < 4.0 && phase % 1.0 == 0.0 && previous >= 0.0 && previous < 6.0 && previous % 1.0 == 0.0 && saved >= 0.0 && saved <= 9007199254740991.0 && saved % 1.0 == 0.0) { return []; }
    if !(value >= 0.0 && value <= 1000000000.0 && value % 1.0 == 0.0) { return [phase, saved, 0]; }
    // idle
    if phase == 0.0 {
        if event == "candidate" {
            return [1, value, 1]; // save_best
        }
    }
    // tracking
    if phase == 1.0 {
        if event == "candidate" && value<saved {
            return [1, value, 2]; // replace_best
        }
        if event == "candidate" && value>=saved {
            return [1, saved, 3]; // retain_best
        }
        if event == "stop" {
            return [2, saved, 4]; // load_best
        }
    }
    // restoring
    if phase == 2.0 {
        if event == "loaded" && value==saved {
            return [3, saved, 5]; // finalize_fit
        }
    }
    [phase, saved, 0]
}

pub fn checkpoint_elect_command(snapshot: vector) -> str {
    if len(snapshot) != 3 { return "invalid"; }
    let action = at(snapshot, 2);
    if action == 0.0 { return "reject"; }
    if action == 1.0 { return "save_best"; }
    if action == 2.0 { return "replace_best"; }
    if action == 3.0 { return "retain_best"; }
    if action == 4.0 { return "load_best"; }
    if action == 5.0 { return "finalize_fit"; }
    "invalid"
}

// Stop at the first rejected event. No host effects run during replay.
pub fn checkpoint_elect_replay(events: arglist, values: vector) -> vector {
    if args_len(events) != len(values) { return []; }
    let mut state = checkpoint_elect_start();
    let mut i = 0;
    while i < len(values) {
        state = checkpoint_elect_step(state, args_at(events, i), at(values, i));
        if at(state, 2) == 0.0 { return []; }
        i += 1;
    }
    state
}
