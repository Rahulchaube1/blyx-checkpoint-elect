use std::cli;
use std::text;
use vendor::checkpoint_elect::checkpoint_elect;

fn main() {
    let arguments = cli_args();
    if args_len(arguments) > 0 {
        if args_len(arguments) % 2 != 0 {
            stderr_line("Expected event and value pairs");
            process_exit(2);
        }
        let mut live = checkpoint_elect_start();
        let mut i = 0;
        while i < args_len(arguments) {
            let input = args_at(arguments, i + 1);
            if !text_is_number(input) {
                stderr_line("Expected a whole numeric event value");
                process_exit(2);
            }
            live = checkpoint_elect_step(live, args_at(arguments, i), text_number(input));
            let command = checkpoint_elect_command(live);
            println!(command);
            if command == "reject" { process_exit(1); }
            i += 2;
        }
        return;
    }
    let mut state = checkpoint_elect_start();
    state = checkpoint_elect_step(state, "candidate", 60.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "candidate", 66.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "candidate", 49.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "stop", 0.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "loaded", 49.0);
    println!(checkpoint_elect_command(state));
}
