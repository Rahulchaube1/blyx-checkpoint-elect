use std::cli;
use vendor::checkpoint_elect::checkpoint_elect;

fn main() {
    let mut state = checkpoint_elect_start();
    state = checkpoint_elect_step(state, "candidate", 60.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "candidate", 66.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "candidate", 49.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "stop", 0.0);
    println!(checkpoint_elect_command(state));
    state = checkpoint_elect_step(state, "loaded", 49.0);
    println!(checkpoint_elect_command(state));
    println!(len(checkpoint_elect_step([], "bad", 0.0)));
    println!(checkpoint_elect_command(checkpoint_elect_step(checkpoint_elect_start(), "unrecognized", 0.0)));
    println!(len(checkpoint_elect_replay(args_new(), [1])));
    let mut events = args_new();
    events = args_push(events, "candidate");
    events = args_push(events, "candidate");
    events = args_push(events, "candidate");
    events = args_push(events, "stop");
    events = args_push(events, "loaded");
    println!(checkpoint_elect_command(checkpoint_elect_replay(events, [60, 66, 49, 0, 49])));
    let branch_0 = checkpoint_elect_step([0, 0, 0], "candidate", 0.0);
    println!(at(branch_0, 0) == 1.0 && at(branch_0, 1) == 0.0 && checkpoint_elect_command(branch_0) == "save_best");
    let branch_1 = checkpoint_elect_step([1, 1, 0], "candidate", 0.0);
    println!(at(branch_1, 0) == 1.0 && at(branch_1, 1) == 0.0 && checkpoint_elect_command(branch_1) == "replace_best");
    let branch_2 = checkpoint_elect_step([1, 0, 0], "candidate", 0.0);
    println!(at(branch_2, 0) == 1.0 && at(branch_2, 1) == 0.0 && checkpoint_elect_command(branch_2) == "retain_best");
    let branch_3 = checkpoint_elect_step([1, 0, 0], "stop", 0.0);
    println!(at(branch_3, 0) == 2.0 && at(branch_3, 1) == 0.0 && checkpoint_elect_command(branch_3) == "load_best");
    let branch_4 = checkpoint_elect_step([2, 0, 0], "loaded", 0.0);
    println!(at(branch_4, 0) == 3.0 && at(branch_4, 1) == 0.0 && checkpoint_elect_command(branch_4) == "finalize_fit");
}
